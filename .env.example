# Copy this file to .env before running ./magento init (the script does this for you
# automatically if .env is missing).
#
# ---- Host user mapping (matches your local user so file perms stay sane) ----
# Note: named HOST_UID/HOST_GID (not UID/GID) because UID is a read-only builtin in bash.
# Auto-synced to your real `id -u`/`id -g` by every ./magento command (see load_env
# in lib/common.sh) -- the values below are just a placeholder for a brand-new .env.
HOST_UID=1000
HOST_GID=1000

# ---- Project ----
COMPOSE_PROJECT_NAME=magento

# ---- Domain / ports ----
NGINX_PORT=80
# HTTPS listener (docker/nginx/default.conf), served with a locally-trusted mkcert
# certificate -- see `./magento certs`. Off by default in Magento's own config
# (web/secure/use_in_frontend|use_in_adminhtml stay 0); the listener is just there
# if you want to test over https:// manually.
NGINX_SSL_PORT=443
PHPMYADMIN_PORT=8080
SEARCH_PORT=9200
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
DB_PORT=3306

# ---- MariaDB ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=magento
MYSQL_USER=magento
MYSQL_PASSWORD=magento

# ---- PHP ----
PHP_VERSION=8.4
PHP_MEMORY_LIMIT=2G
XDEBUG_MODE=off

# ---- Search engine ----
# SEARCH_ENGINE is "opensearch" or "elasticsearch" -- you'll be prompted for it by
# `./magento init` (only versions Adobe lists as supported for MAGENTO_VERSION are
# offered; see lib/versions.tsv). COMPOSE_PROFILES must always match SEARCH_ENGINE --
# it's what tells `docker compose` which of the two search-engine services to start.
SEARCH_ENGINE=opensearch
COMPOSE_PROFILES=opensearch

# ---- Dependency versions (auto-set by `./magento init` to match MAGENTO_VERSION per
#      Adobe's system requirements --
#      https://experienceleague.adobe.com/en/docs/commerce-operations/installation-guide/system-requirements
#      and lib/versions.tsv -- don't edit by hand unless you know what you're doing) ----
MARIADB_VERSION=11.4
OPENSEARCH_VERSION=3.8.0
ELASTICSEARCH_VERSION=8.11.0
COMPOSER_VERSION=2.10

# ---- Magento install defaults (used by `./magento init`; you'll also be prompted
#      interactively for MAGENTO_VERSION / PHP_VERSION on a fresh install) ----
# MAGENTO_VERSION is a git branch or tag in MAGENTO_REPO_URL below — e.g. "2.4-develop"
# (the active development branch) or a stable release tag like "2.4.8".
MAGENTO_VERSION=2.4-develop
MAGENTO_REPO_URL=https://github.com/magento/magento2.git
BASE_URL=http://localhost/
LANGUAGE=en_US
CURRENCY=USD
TIMEZONE=UTC
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User
ADMIN_EMAIL=admin@example.com
ADMIN_USER=admin
ADMIN_PASSWORD=Admin123!
ADMIN_FRONTNAME=admin
